---
import type { ImageMetadata } from "astro";
import { asciiPreview } from "../lib/ascii-image";
import { publicProjectImagePath } from "../lib/project-display";

interface Props {
  image: ImageMetadata;
  slug: string;
  alt: string;
  columns?: number;
  rows?: number;
  caption?: string;
  label?: string;
  class?: string;
}

const {
  image,
  slug,
  alt,
  columns = 48,
  rows,
  caption,
  label,
  class: className = "",
} = Astro.props;

const art = await asciiPreview(image, slug, { columns, rows });
const description = caption ?? alt;
const src = publicProjectImagePath(slug, image);
---

<figure class:list={["ascii-plate", className]} data-ascii-plate>
  <a
    class="ascii-plate__open"
    href={src}
    data-ascii-plate-open
    aria-label={`View image: ${alt}`}
  >
    <span class="ascii-plate__art" aria-hidden="true" set:text={art} />
  </a>
  <figcaption class="ascii-plate__caption">
    <span class="ascii-plate__text">
      {label && <span class="ascii-plate__label">{label}</span>}
      <span>{description}</span>
    </span>
    <a class="ascii-plate__link" href={src} data-ascii-plate-open>
      view image <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>

<dialog
  class="ascii-plate__viewer"
  data-ascii-plate-viewer
  aria-label={`Image: ${alt}`}
>
  <figure class="ascii-plate__viewer-figure">
    <img
      class="ascii-plate__viewer-image"
      src={src}
      alt={alt}
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
    />
    <figcaption class="ascii-plate__viewer-caption">
      <span class="ascii-plate__viewer-text">{description}</span>
      <button
        class="ascii-plate__viewer-close"
        type="button"
        data-ascii-plate-close
      >
        close <span aria-hidden="true">✕</span>
      </button>
    </figcaption>
  </figure>
</dialog>

<script>
  import "../scripts/ascii-plate";
</script>
