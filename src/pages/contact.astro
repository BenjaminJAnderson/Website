---
import { contactChannels } from "../data/contact";
import TerminalLayout from "../layouts/TerminalLayout.astro";
---

<TerminalLayout
  title="Contact"
  description="Contact Benjamin Anderson by email, GitHub, LinkedIn or Twitter."
  path="~/contact"
  command="contact"
>
  <section class="contact-tui" aria-labelledby="contact-title" data-contact-tui>
    <span
      class="contact-tui__label contact-tui__label--title"
      aria-hidden="true"
    >
      contact
    </span>
    <span
      class="contact-tui__label contact-tui__label--status"
      aria-hidden="true"
    >
      ONLINE
    </span>

    <header class="contact-tui__header">
      <h1 id="contact-title" class="contact-tui__title" data-contact-title>
        COMMUNICATIONS TERMINAL
      </h1>
      <p class="contact-tui__subtitle">BENJAMIN ANDERSON // PERSONAL NETWORK</p>
      <p class="contact-tui__status">
        <span class="contact-tui__status-dot" aria-hidden="true"></span>
        Available for interesting projects
      </p>
    </header>

    <div class="contact-tui__grid">
      {contactChannels.map((channel) => (
        <article
          class="contact-card"
          aria-labelledby={`contact-card-${channel.id}`}
        >
          <h2 id={`contact-card-${channel.id}`} class="contact-card__heading">
            <span
              class="contact-card__notch contact-card__notch--left"
              aria-hidden="true"
            ></span>
            <span>
              {channel.index} / {channel.label}
            </span>
            <span
              class="contact-card__notch contact-card__notch--right"
              aria-hidden="true"
            ></span>
          </h2>

          <span class="contact-card__glyph" aria-hidden="true">
            {channel.glyph}
          </span>
          <p class="contact-card__title">{channel.title}</p>
          <p class="contact-card__description">{channel.description}</p>
          <p class="contact-card__value">{channel.value}</p>

          <div class="contact-card__actions">
            <a
              class="contact-card__action"
              href={channel.href}
              rel={channel.rel}
              data-contact-nav
              aria-label={`${channel.action} ${channel.title}: ${channel.value}`}
            >
              [ {channel.action} ]
            </a>
            {channel.copy && (
              <button
                type="button"
                class="contact-card__copy"
                data-contact-copy
                aria-label={`Copy ${channel.value} to clipboard`}
              >
                [ COPY ]
              </button>
            )}
          </div>
        </article>
      ))}
    </div>

    <footer class="contact-tui__keybar">
      <span>ARROWS MOVE</span>
      <span>TAB NEXT</span>
      <span>ENTER SELECT</span>
      <a
        class="contact-tui__back"
        href="/"
        data-contact-nav
        aria-label="Back to home page"
      >
        ESC / BACKSPACE BACK
      </a>
    </footer>
  </section>
</TerminalLayout>

<script>
  import "../scripts/contact";
</script>
