---
import { identity } from "../data/ascii";
import { site } from "../data/site";
import TerminalLayout from "../layouts/TerminalLayout.astro";
---

<TerminalLayout path="~" command="./welcome">
  <pre class="term-ascii" aria-hidden="true">{identity}</pre>

  <h1 class="term-heading">{site.name}</h1>
  <p class="term-line">
    {site.role}. Hardware, firmware and the tools around them.
  </p>
  <p class="term-line term-muted">
    This is a record of the things I build, the decisions behind them, and what
    I learn along the way.
  </p>

  <p class="term-line">
    Type
    <button class="term-command" type="button" data-terminal-command="help">
      help
    </button>
    to list commands, or use the plain links below.
  </p>

  <p class="term-line term-dim">
    <a href="/about/">about</a>
    <a href="/projects/">projects</a>
    <a href="/contact/">contact</a>
    <a href={site.cv}>cv</a>
  </p>
</TerminalLayout>
