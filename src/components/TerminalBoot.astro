<div class="terminal-boot" data-terminal-boot>
  <div class="terminal-boot__content" data-terminal-boot-content>
    <h1 class="terminal-boot__wordmark" data-terminal-boot-wordmark>
      benji
    </h1>

    <div class="terminal-boot__pacman" data-terminal-boot-pacman>
      <p class="boot-line" data-boot-line data-boot-key="sync">
        :: Synchronising package databases
        <span class="boot-dots" data-boot-dots aria-hidden="true">
          ...
        </span>
      </p>
      <p class="boot-line" data-boot-line data-boot-key="core">
        core is up to date
      </p>
      <p class="boot-line" data-boot-line data-boot-key="extra">
        extra is up to date
      </p>
      <p class="boot-line" data-boot-line data-boot-key="sync-blank">
        &nbsp;
      </p>
      <p class="boot-line" data-boot-line data-boot-key="install">
        :: Installing benji-portfolio-git
        <span class="boot-dots" data-boot-dots aria-hidden="true">
          ...
        </span>
      </p>
      <p class="boot-line" data-boot-line data-boot-key="resolve">
        resolving dependencies...
      </p>
      <p class="boot-line" data-boot-line data-boot-key="looking">
        looking for conflicting packages...
      </p>
      <p class="boot-line" data-boot-line data-boot-key="install-blank">
        &nbsp;
      </p>
      <p class="boot-line" data-boot-line data-boot-key="packages">
        Packages (1) benji-portfolio-git-1.0.0-1
      </p>
      <p class="boot-line" data-boot-line data-boot-key="description">
        A terminal portfolio for Benjamin Anderson.
      </p>
      <p class="boot-line" data-boot-line data-boot-key="depends">
        Depends On: none
      </p>
      <p class="boot-line" data-boot-line data-boot-key="summary-blank">
        &nbsp;
      </p>
      <p class="boot-line" data-boot-line data-boot-key="download">
        Total Download Size: 0.00 MiB
      </p>
      <p class="boot-line" data-boot-line data-boot-key="installed">
        Total Installed Size: 0.42 MiB
      </p>
      <p class="boot-line" data-boot-line data-boot-key="final-blank">
        &nbsp;
      </p>
      <div class="boot-question" data-boot-question tabindex="-1" hidden>
        <span class="boot-question__text">
          :: Proceed with entering the website?
        </span>
        <span class="boot-choices">
          [
          <button
            type="button"
            data-boot-yes
            aria-label="Yes, enter the website"
          >
            Y
          </button>
          /
          <button type="button" data-boot-no aria-label="No, cancel">
            n
          </button>
          ]
        </span>
        <span class="boot-answer-field">
          <input
            class="boot-answer"
            data-boot-answer
            type="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Type yes or no, then press Enter"
          />
          <span
            class="boot-answer-measure"
            data-boot-answer-measure
            aria-hidden="true"
          ></span>
          <span class="boot-cursor" data-boot-cursor aria-hidden="true">
            █
          </span>
        </span>
      </div>
      <p
        class="boot-answer-hint"
        data-boot-answer-hint
        role="status"
        aria-live="polite"
        hidden
      >
        Please answer y or n.
      </p>
      <div class="boot-cancel" data-boot-cancel tabindex="-1" hidden>
        <p class="boot-line">:: Cancelled.</p>
        <p class="boot-line">benji-portfolio-git was not installed.</p>
        <p class="boot-line">
          Press Enter or click
          <button
            type="button"
            data-boot-continue
            aria-label="Continue into the website"
          >
            continue
          </button>
          to enter anyway.
        </p>
      </div>
    </div>
  </div>
</div>
