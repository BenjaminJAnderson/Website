---
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import TerminalBoot from "../components/TerminalBoot.astro";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeStyles from "../components/ThemeStyles.astro";
import { buildProjectCommands, staticCommands } from "../data/commands";
import { BOOT_SESSION_KEY } from "../data/boot";
import { site, terminalIdentity } from "../data/site";
import { defaultTheme } from "../data/themes";
import { getPublishedProjects } from "../lib/projects";
import { buildTerminalFileSystem } from "../lib/terminal-fs";

interface Props {
  title?: string;
  description?: string;
  path: string;
  command?: string;
  noindex?: boolean;
  boot?: boolean;
}

const {
  title = site.name,
  description = site.description,
  path,
  command,
  noindex = false,
  boot = true,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const shouldBoot = boot && path === "~";

const projects = await getPublishedProjects();
const commands = [
  ...staticCommands,
  ...buildProjectCommands(
    projects.map((project) => ({
      slug: project.id,
      title: project.data.title,
      summary: project.data.summary,
    })),
  ),
];
const commandData = JSON.stringify(commands).replace(/</g, "\\u003c");
const fileSystem = buildTerminalFileSystem(
  projects.map((project) => ({
    slug: project.id,
    summary: project.data.summary,
  })),
  site.cv,
);
const fileSystemData = JSON.stringify(fileSystem).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content={defaultTheme.colors.background} />
    <script
      is:inline
      set:html={`try { if (sessionStorage.getItem(${JSON.stringify(
        BOOT_SESSION_KEY,
      )}) !== "1") { document.documentElement.dataset.bootPending = ""; } } catch { document.documentElement.dataset.bootPending = ""; }`}
    ></script>
    <ThemeStyles />
    <ThemeInit />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="terminal-body">
    <noscript>
      <style>
        .terminal-boot,
        .terminal-prompt {
          display: none !important;
        }
      </style>
    </noscript>

    <a class="skip-link" href="#terminal-input">
      skip to terminal input
    </a>

    <div
      class="terminal-app"
      data-terminal-app
      data-path={path}
      data-route={Astro.url.pathname}
    >
      <div class="terminal-status">
        <span>
          {terminalIdentity}:{path}
        </span>
        <span class="terminal-status__right">{site.host}</span>
      </div>

      <main id="main" class="terminal-screen" aria-label="Terminal output">
        <div class="terminal-output" data-terminal-output>
          {command && (
            <div class="terminal-echo">
              <span class="terminal-echo__prompt">$</span> {command}
            </div>
          )}
          <slot />
        </div>
        <p
          id="terminal-status"
          class="sr-only"
          role="status"
          aria-live="polite"
        ></p>
      </main>

      <form class="terminal-prompt" data-terminal-form hidden>
        <label class="sr-only" for="terminal-input">
          Terminal command
        </label>
        <span class="terminal-prompt__label">
          {terminalIdentity}:{path}$
        </span>
        <div class="terminal-prompt__field" data-terminal-field>
          <input
            id="terminal-input"
            data-terminal-input
            type="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="type a command, or type help"
          />
          <span
            class="terminal-prompt__measure"
            data-terminal-measure
            aria-hidden="true"
          ></span>
          <span
            class="terminal-prompt__cursor"
            data-terminal-cursor
            aria-hidden="true"
          ></span>
        </div>
      </form>
    </div>

    {shouldBoot && <TerminalBoot />}

    <script
      type="application/json"
      id="terminal-commands"
      set:html={commandData}
    ></script>
    <script
      type="application/json"
      id="terminal-filesystem"
      set:html={fileSystemData}
    ></script>
    <script>
      import "../scripts/terminal";
    </script>
  </body>
</html>
