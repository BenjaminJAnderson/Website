---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="Page not found." noindex>
  <div class="container not-found">
    <p class="breadcrumb">~/404</p>
    <p class="not-found__code" aria-hidden="true">
      404
    </p>
    <h1>Path not found.</h1>
    <p class="muted">
      The page you are looking for does not exist, or it has moved. Try the
      project index or head back home.
    </p>
    <div class="actions">
      <a class="button button--primary" href="/">
        Go home
      </a>
      <a class="button" href="/projects/">
        View projects
      </a>
    </div>
  </div>
</BaseLayout>
