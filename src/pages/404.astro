---
import TerminalLayout from "../layouts/TerminalLayout.astro";
---

<TerminalLayout
  title="404"
  description="Page not found."
  path="~/404"
  command="cat /404"
  noindex
>
  <h1 class="term-heading">404</h1>
  <p class="term-line terminal-error">cat: /404: No such file or directory</p>
  <p class="term-line term-muted">
    The page you are looking for does not exist, or it has moved.
  </p>
  <p class="term-line term-dim">
    <a href="/">home</a>
    <a href="/projects/">projects</a>
    <button class="term-command" type="button" data-terminal-command="help">
      help
    </button>
  </p>
</TerminalLayout>
