<div class="terminal-boot" data-terminal-boot>
  <div class="terminal-boot__content" data-terminal-boot-content>
    <h1 class="terminal-boot__wordmark" data-terminal-boot-wordmark>
      benji
    </h1>

    <div class="terminal-boot__pacman" data-terminal-boot-pacman>
      <p class="boot-line" data-boot-line>
        :: Synchronising package databases...
      </p>
      <p class="boot-line" data-boot-line>
        core is up to date
      </p>
      <p class="boot-line" data-boot-line>
        extra is up to date
      </p>
      <p class="boot-line" data-boot-line>
        &nbsp;
      </p>
      <p class="boot-line" data-boot-line>
        :: Installing benji-portfolio-git...
      </p>
      <p class="boot-line" data-boot-line>
        resolving dependencies...
      </p>
      <p class="boot-line" data-boot-line>
        looking for conflicting packages...
      </p>
      <p class="boot-line" data-boot-line>
        &nbsp;
      </p>
      <p class="boot-line" data-boot-line>
        Packages (1) benji-portfolio-git-1.0.0-1
      </p>
      <p class="boot-line" data-boot-line>
        A terminal portfolio for Benjamin Anderson.
      </p>
      <p class="boot-line" data-boot-line>
        Depends On: none
      </p>
      <p class="boot-line" data-boot-line>
        &nbsp;
      </p>
      <p class="boot-line" data-boot-line>
        Total Download Size: 0.00 MiB
      </p>
      <p class="boot-line" data-boot-line>
        Total Installed Size: 0.42 MiB
      </p>
      <p class="boot-line" data-boot-line>
        &nbsp;
      </p>
      <div class="boot-question" data-boot-question tabindex="-1" hidden>
        <span class="boot-question__text">
          :: Proceed with entering the website?
        </span>
        <span class="boot-choices">
          [
          <button
            type="button"
            data-boot-yes
            aria-label="Yes, enter the website"
          >
            Y
          </button>
          /
          <button type="button" data-boot-no aria-label="No, cancel">
            n
          </button>
          ]
        </span>
        <span class="boot-cursor" data-boot-cursor aria-hidden="true">
          █
        </span>
      </div>
      <div class="boot-cancel" data-boot-cancel tabindex="-1" hidden>
        <p class="boot-line">:: Cancelled.</p>
        <p class="boot-line">benji-portfolio-git was not installed.</p>
        <p class="boot-line">
          Press Enter or click
          <button
            type="button"
            data-boot-continue
            aria-label="Continue into the website"
          >
            continue
          </button>
          to enter anyway.
        </p>
      </div>
    </div>
  </div>
</div>
