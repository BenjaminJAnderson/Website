---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-mark">BENJI / ENGIEBENJI</span>
      <span class="footer-note">
        Electronics engineer. Hardware, firmware and the tools around them.
      </span>
    </div>

    <ul class="footer-links" aria-label="Elsewhere">
      <li>
        <a href={site.github} rel="me">
          GitHub
        </a>
      </li>
      <li>
        <a href={site.linkedin} rel="me">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`}>Email</a>
      </li>
      <li>
        <a href={site.cv}>CV</a>
      </li>
    </ul>

    <div class="footer-meta">
      © {year} {site.name}
      <br />
      Built with Astro
    </div>
  </div>
</footer>
