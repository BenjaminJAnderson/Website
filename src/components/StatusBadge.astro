---
import { statusLabels, type ProjectStatus } from "../data/project-status";

interface Props {
  status: ProjectStatus;
  class?: string;
}

const { status, class: className = "" } = Astro.props;

const glyphs: Record<ProjectStatus, string> = {
  shipped: "●",
  "in-progress": "◐",
  prototype: "○",
  archived: "×",
};
---

<span class:list={["status-badge", `status-badge--${status}`, className]}>
  <span class="status-badge__glyph" aria-hidden="true">
    {glyphs[status]}
  </span>
  <span>{statusLabels[status].toLowerCase()}</span>
</span>
