---
import { render } from "astro:content";
import { getPublishedProjects } from "../../lib/projects";
import {
  getAdjacentProjects,
  projectId,
  projectRepoLabel,
} from "../../lib/project-display";
import TerminalLayout from "../../layouts/TerminalLayout.astro";
import AsciiPreview from "../../components/AsciiPreview.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import ProjectNav from "../../components/ProjectNav.astro";
import ProjectToc from "../../components/ProjectToc.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import TagList from "../../components/TagList.astro";
import "../../styles/projects.css";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const projects = await getPublishedProjects();
const index = projects.findIndex((item) => item.id === project.id);
const id = projectId(index);
const { previous, next } = getAdjacentProjects(projects, project.id);
const period = data.period ?? String(data.year);
---

<TerminalLayout
  title={data.title}
  description={data.summary}
  path={`~/projects/${project.id}`}
  command={`open ${project.id}`}
>
  <article class="project-document">
    <header class="project-hero">
      <p class="project-hero__path">~/projects/{project.id}</p>

      <div class="project-hero__heading">
        <h1 class="project-hero__title">
          <span class="project-hero__id">[{id}]</span>
          {data.title}
        </h1>
        <p class="project-hero__status">
          <StatusBadge status={data.status} />
          <span class="project-hero__period">{period}</span>
        </p>
      </div>

      <p class="project-hero__summary">{data.summary}</p>
    </header>

    <AsciiPreview
      image={data.cover}
      slug={project.id}
      alt={data.coverAlt}
      columns={80}
      rows={23}
      caption={data.coverAlt}
      class="project-hero__cover"
    />

    <dl class="term-facts project-meta">
      {data.role && (
        <>
          <dt>role</dt>
          <dd>{data.role}</dd>
        </>
      )}
      <dt>stack</dt>
      <dd>{data.tech.join(" · ")}</dd>
      {data.tags.length > 0 && (
        <>
          <dt>tags</dt>
          <dd>
            <TagList tags={data.tags} label={`${data.title} tags`} />
          </dd>
        </>
      )}
      {data.repo && (
        <>
          <dt>source</dt>
          <dd>
            <a href={data.repo} target="_blank" rel="noopener noreferrer">
              {projectRepoLabel(data.repo)} <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </>
      )}
      {data.demo && (
        <>
          <dt>demo</dt>
          <dd>
            <a href={data.demo} target="_blank" rel="noopener noreferrer">
              {projectRepoLabel(data.demo)} <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </>
      )}
    </dl>

    <div class="project-document__grid">
      <ProjectToc headings={headings} />

      <div class="project-document__main">
        <div class="term-prose project-prose">
          <Content />
        </div>

        <ProjectGallery project={project} />

        <ProjectNav previous={previous} next={next} />

        <p class="project-footer-links">
          <a href="/projects/">← projects</a>
          <a href="/">home</a>
        </p>
      </div>
    </div>
  </article>

  <dialog
    class="ascii-plate__viewer"
    data-prose-image-viewer
    aria-label="Image viewer"
  >
    <figure class="ascii-plate__viewer-figure">
      <img
        class="ascii-plate__viewer-image"
        data-prose-image-viewer-image
        alt=""
        decoding="async"
      />
      <figcaption class="ascii-plate__viewer-caption">
        <span
          class="ascii-plate__viewer-text"
          data-prose-image-viewer-caption
        ></span>
        <button
          class="ascii-plate__viewer-close"
          type="button"
          data-prose-image-viewer-close
        >
          close <span aria-hidden="true">✕</span>
        </button>
      </figcaption>
    </figure>
  </dialog>
</TerminalLayout>
