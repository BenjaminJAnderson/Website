---
import {
  logoArt,
  neofetchFacts,
  neofetchHeader,
  neofetchPalette,
  neofetchRule,
} from "../data/neofetch";
import { site } from "../data/site";
import TerminalHelp from "../components/TerminalHelp.astro";
import { ansiToHtml } from "../lib/ansi";
import TerminalLayout from "../layouts/TerminalLayout.astro";
---

<TerminalLayout path="~" command="neofetch">
  <h1 class="sr-only">{site.name}</h1>

  <div class="term-neofetch term-neofetch--logo">
    <div class="term-neofetch__logo" data-neofetch-logo aria-hidden="true">
      <pre
        class="term-ascii"
        data-neofetch-logo-fallback
        set:html={ansiToHtml(logoArt)}
      ></pre>
    </div>

    <div class="term-neofetch__details">
      <p class="term-neofetch__header" set:html={ansiToHtml(neofetchHeader)} />
      <p class="term-neofetch__rule" set:html={ansiToHtml(neofetchRule)} />

      <dl class="term-facts">
        {neofetchFacts.map((fact) => (
          <>
            <dt set:html={ansiToHtml(fact.label)} />
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>

      <pre
        class="term-palette"
        aria-hidden="true"
        set:html={ansiToHtml(neofetchPalette)}
      ></pre>
    </div>
  </div>

  <TerminalHelp />

  <noscript>
    <p class="term-line terminal-dim">
      <a href="/about/">about</a>
      <a href="/projects/">projects</a>
      <a href="/contact/">contact</a>
      <a href={site.cv}>cv</a>
    </p>
  </noscript>
</TerminalLayout>
