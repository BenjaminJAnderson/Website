---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  linked?: boolean;
  eager?: boolean;
}

const { project, linked = true, eager = false } = Astro.props;
---

<article class="project-card" id={project.slug}>
  {linked ? (
    <a
      class="project-card__media"
      href={project.href}
      aria-hidden="true"
      tabindex="-1"
    >
      <img
        src={project.image}
        alt=""
        width="800"
        height="500"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </a>
  ) : (
    <div class="project-card__media">
      <img
        src={project.image}
        alt={project.imageAlt}
        width="800"
        height="500"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </div>
  )}

  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{project.status}</span>
      <span>{project.year}</span>
    </div>

    <h3>
      {linked ? <a href={project.href}>{project.title}</a> : project.title}
    </h3>

    <p>{project.summary}</p>

    <ul class="tags" aria-label={`Technologies used in ${project.title}`}>
      {project.tech.map((item) => (
        <li class="tag">{item}</li>
      ))}
    </ul>
  </div>
</article>
