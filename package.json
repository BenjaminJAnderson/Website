{
  "name": "engiebenji-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run sync:projects",
    "build": "astro build",
    "prebuild": "npm run sync:projects",
    "preview": "astro preview",
    "check": "astro check",
    "precheck": "npm run sync:projects",
    "sync:projects": "node scripts/sync-projects.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"tests/**/*.ts\" package.json tsconfig.json astro.config.mjs prettier.config.mjs vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"tests/**/*.ts\" package.json tsconfig.json astro.config.mjs prettier.config.mjs vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "themes:pull": "node scripts/pull-themes.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "asciify-engine": "4.31.0",
    "astro": "6.4.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
