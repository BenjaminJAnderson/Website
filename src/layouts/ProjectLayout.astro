---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { statusLabels } from "../lib/projects";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const period = data.period ?? String(data.year);
const hasGallery = data.gallery.length > 0;
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="project-page container">
    <header class="project-header">
      <p class="breadcrumb">
        <a href="/projects/">~/projects</a> / {project.id}
      </p>
      <h1>{data.title}</h1>
      <p class="project-summary">{data.summary}</p>

      <dl class="facts project-facts">
        <dt>year</dt>
        <dd>{period}</dd>

        {data.role && (
          <>
            <dt>role</dt>
            <dd>{data.role}</dd>
          </>
        )}

        <dt>status</dt>
        <dd>{statusLabels[data.status]}</dd>

        <dt>stack</dt>
        <dd>
          <ul class="tags" aria-label="Technologies used">
            {data.tech.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </dd>

        {(data.repo || data.demo) && (
          <>
            <dt>links</dt>
            <dd class="project-links">
              {data.repo && (
                <a href={data.repo} target="_blank" rel="noopener noreferrer">
                  Source repository ↗
                </a>
              )}
              {data.demo && (
                <a href={data.demo} target="_blank" rel="noopener noreferrer">
                  Live project ↗
                </a>
              )}
            </dd>
          </>
        )}
      </dl>
    </header>

    <figure class="project-hero">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        width={1400}
        format="webp"
        quality={82}
        loading="eager"
      />
    </figure>

    <div class="project-body">
      <div class="prose">
        <slot />
      </div>
    </div>

    {hasGallery && (
      <section class="project-gallery" aria-labelledby="gallery-heading">
        <div class="section-header">
          <h2 id="gallery-heading">Gallery</h2>
          <p>Photographs and diagrams from the build.</p>
        </div>

        <div class="project-gallery__grid">
          {data.gallery.map((item) => (
            <figure class="project-gallery__item">
              <Image
                src={item.src}
                alt={item.alt}
                width={1200}
                format="webp"
                quality={82}
                loading="lazy"
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <footer class="project-footer">
      <a href="/projects/">← All projects</a>
      {data.repo && (
        <a href={data.repo} target="_blank" rel="noopener noreferrer">
          View source ↗
        </a>
      )}
    </footer>
  </article>
</BaseLayout>
