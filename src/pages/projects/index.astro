---
import ProjectCard from "../../components/ProjectCard.astro";
import { getPublishedProjects, toProjectCard } from "../../lib/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getPublishedProjects()).map(toProjectCard);
---

<BaseLayout
  title="Projects"
  description="Hardware, firmware and software projects by Benjamin Anderson."
>
  <div class="container">
    <header class="page-header">
      <p class="breadcrumb">~/projects</p>
      <h1>Projects</h1>
      <p>
        A working index of hardware, firmware and software projects. Each entry
        links to a full case study with the design decisions, photographs and
        technical notes behind it.
      </p>
    </header>

    <section aria-label="Project index">
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <p class="index-note">
      More write-ups, photographs and technical notes are on the way. Project
      content is authored in Markdown and lives alongside the site.
    </p>
  </div>
</BaseLayout>
